# LGS AI Coach — Örnek ortam değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayıp doldurun (`.env.local` Git'e girmez).
# Burada yalnızca değişken adları ve güvenli yer tutucular bulunur: gerçek anahtar yazmayın.

# ==========================================================================
# AI SAĞLAYICI SEÇİMİ
#   auto        → sırayla dene: openai → gemini → openrouter  (varsayılan)
#   openai      → OpenAI'yi başa al, kalanlarla yedekle
#   gemini      → Gemini'yi başa al, kalanlarla yedekle
#   openrouter  → OpenRouter'ı başa al, kalanlarla yedekle
# Anahtarı tanımlı olmayan sağlayıcı zincire hiç girmez.
# ==========================================================================
AI_PROVIDER=auto

# Yedek sırasını tamamen değiştirmek isterseniz (opsiyonel):
# AI_FALLBACK_ORDER=openai,gemini,openrouter

# --- OpenAI — https://platform.openai.com/api-keys ---
OPENAI_API_KEY=
# Boş bırakılırsa, anahtarın erişebildiği uygun model otomatik keşfedilir.
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini (ücretsiz katman) — https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- OpenRouter — https://openrouter.ai/keys ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Opsiyonel ayarlar ---
AI_TIMEOUT_MS=45000
AI_MAX_PROMPT_CHARS=4000
AI_MAX_IMAGE_BYTES=8000000
AI_APP_URL=http://localhost:3000

# --- Site adresi (canonical / robots.txt / sitemap.xml) ---
# Üretimde gerçek alan adını yazın; boşsa http://localhost:3000 kullanılır.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
