# Soru: Freebuff Web Projesi — Örnek Ortam Değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayıp doldurun (`.env.local` git'e girmez).

# ==========================================================================
# AI SAĞLAYICI SEÇİMİ
#   auto        → sırayla dene: gemini → openrouter → local  (varsayılan)
#   gemini      → Gemini'yi başa al, kalanlarla yedekle
#   openrouter  → OpenRouter'ı başa al, kalanlarla yedekle
#   local       → Yerel modeli başa al, kalanlarla yedekle
# Anahtarı/URL'i tanımlı olmayan sağlayıcı zincire hiç girmez.
# ==========================================================================
AI_PROVIDER=auto

# Yedek sırasını tamamen değiştirmek isterseniz (opsiyonel):
# AI_FALLBACK_ORDER=gemini,openrouter,local

# --- Google Gemini (ücretsiz katman) — https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- OpenRouter — https://openrouter.ai/keys ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/free

# --- Yerel OpenAI-uyumlu sunucu (LM Studio / Ollama / vLLM) ---
# /v1 ekini dahil edin; LM Studio varsayılanı: http://localhost:1234/v1
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
# LOCAL_AI_API_KEY=

# --- Opsiyonel ayarlar ---
AI_TIMEOUT_MS=45000
AI_MAX_PROMPT_CHARS=4000
AI_MAX_IMAGE_BYTES=8000000
AI_APP_URL=http://localhost:3000
