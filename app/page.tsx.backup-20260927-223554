'use client';

import { useEffect, useMemo, useState } from 'react';

type Gender = 'girl' | 'boy';
type Tab = 'Ana Sayfa' | 'Çalış' | 'AI Koç' | 'Dersler' | 'Sınavlar' | 'Kaynaklar' | 'Ödüller' | 'İlerleme' | 'Profil';
type Profile = { name: string; gender: Gender; avatar: number };
type AnswerState = 'idle' | 'correct' | 'wrong';

const nav: { label: Tab; icon: string }[] = [
  ['Ana Sayfa', '⌂'], ['Çalış', '▣'], ['AI Koç', '🤖'], ['Dersler', '▤'], ['Sınavlar', '◈'],
  ['Kaynaklar', '◉'], ['Ödüller', '⭐'], ['İlerleme', '▥'], ['Profil', '◯'],
].map(([label, icon]) => ({ label: label as Tab, icon }));

const avatars = { boy: ['/avatars/boy.svg', '/avatars/boy.svg', '/avatars/boy.svg'], girl: ['/avatars/girl.svg', '/avatars/girl.svg', '/avatars/girl.svg'] };
const subjects: [string, number, string, string][] = [
  ['Matematik', 72, '+6%', 'pink'],
  ['Türkçe', 81, '+3%', 'blue'],
  ['Fen', 64, '+12%', 'green'],
  ['İngilizce', 78, '+4%', 'purple'],
];
const tasks = [['🎯', 'Matematik – Üslü İfadeler', '10 soru + hata analizi', '+10 XP'], ['📘', 'Konu Tekrarı', 'Video + mini test', '+15 XP'], ['📝', 'Haftalık Mini Test', '20 soru', '+20 XP']];

const question = {
  subject: 'Matematik', topic: 'Üslü İfadeler',
  text: 'Aşağıdakilerden hangisi 2³ · 2⁵ işleminin sonucuna eşittir?',
  options: ['2⁸', '2¹⁰', '2¹²', '2¹⁵'], correct: 0,
  skill: 'Bilgiyi problem içinde yorumlama', difficulty: 2,
};

function defaultProfile(): Profile { return { name: 'Öğrenci', gender: 'boy', avatar: 0 }; }

export default function Home() {
  const [profile, setProfile] = useState<Profile>(defaultProfile());
  const [tab, setTab] = useState<Tab>('Ana Sayfa');
  const [onboarding, setOnboarding] = useState(false);
  const [draft, setDraft] = useState<Profile>(defaultProfile());
  const [gameOpen, setGameOpen] = useState(false);
  const [studyOpen, setStudyOpen] = useState(false);

  useEffect(() => { const saved = localStorage.getItem('lgs-ai-coach-profile'); if (saved) setProfile(JSON.parse(saved)); }, []);
  const avatar = useMemo(() => avatars[profile.gender][profile.avatar % 3], [profile]);
  const draftAvatar = avatars[draft.gender];
  function openProfile() { setDraft(profile); setOnboarding(true); }
  function saveProfile() { const next = { ...draft, name: draft.name.trim() || 'Öğrenci' }; setProfile(next); localStorage.setItem('lgs-ai-coach-profile', JSON.stringify(next)); setOnboarding(false); }

  return <main className="shell">
    <aside className="sidebar"><div className="brand"><span className="brandIcon">🎓</span><b>LGS AI COACH</b><small>Senin Yol Arkadaşın</small></div><nav>{nav.map(item => <button key={item.label} onClick={() => setTab(item.label)} className={`nav ${tab === item.label ? 'active' : ''}`}><span>{item.icon}</span>{item.label}</button>)}</nav><div className="sideCoach"><span>🏆</span><b>Bugün harika gidiyorsun!</b><small>Hedefine bir adım daha yaklaştın.</small></div></aside>
    <section className="content">
      <header><div><h1>Merhaba {profile.name} 👋</h1><p>Bugün hedeflerine birlikte devam edelim!</p></div><input className="search" placeholder="Konu, soru veya video ara..." /><div className="topstats"><span>🔥 4 gün seri</span><span>⭐ 245 XP</span><button onClick={openProfile}><img src={avatar} alt="Öğrenci avatarı" /></button></div></header>
      {tab === 'Ana Sayfa' && <Dashboard avatar={avatar} onProfile={openProfile} onGame={() => setGameOpen(true)} onStudy={() => setStudyOpen(true)} />}
      {tab === 'Çalış' && <StudyHome onStart={() => setStudyOpen(true)} />}
      {tab === 'AI Koç' && <CoachPage avatar={avatar} />}
      {tab === 'İlerleme' && <ProgressPage />}
      {tab === 'Ödüller' && <RewardsPage onGame={() => setGameOpen(true)} />}
      {tab !== 'Ana Sayfa' && !['Çalış','AI Koç','İlerleme','Ödüller'].includes(tab) && <Placeholder tab={tab} onProfile={openProfile} onGame={() => setGameOpen(true)} />}
    </section>
    {onboarding && <ProfileModal draft={draft} setDraft={setDraft} avatarsForGender={draftAvatar} avatar={draftAvatar[draft.avatar % 3]} onClose={() => setOnboarding(false)} onSave={saveProfile} />}
    {gameOpen && <GameModal onClose={() => setGameOpen(false)} />}
    {studyOpen && <QuestionModal avatar={avatar} onClose={() => setStudyOpen(false)} />}
  </main>;
}

function Dashboard({ avatar, onProfile, onGame, onStudy }: { avatar: string; onProfile: () => void; onGame: () => void; onStudy: () => void }) {
  return <>
    <div className="grid"><section className="hero"><div className="heroImage"><img src={avatar} alt="Öğrenci karakteri" /><div className="bubble">Bugün 3 görevimiz var!<br />Birlikte başaracağız! 🚀</div></div><div className="heroTasks"><h2>Bugünün Görevleri <a>Tümünü Gör</a></h2>{tasks.map((t,i) => <div className="task" key={t[1]}><span className="taskIcon">{t[0]}</span><div><b>{t[1]}</b><small>{t[2]}</small></div><em>{t[3]}</em><button onClick={onStudy}>Başla</button></div>)}</div></section>
      <section className="coach"><h2>🤖 AI Koçum</h2><p>Bugünkü analizine göre önerim:</p><div className="coachBox">Üslü ifadelerdeki soru tiplerinde ilerleme var. Şimdi cebirsel ifadeleri kısa bir tekrar ile pekiştirelim.</div><h2>Son Çalışmalar</h2>{['Üslü İfadeler – 10 soru','Cebirsel İfadeler – 15 soru','Fen – Madde ve Değişim'].map(x => <div className="recent" key={x}>📚 <b>{x}</b><span>• bugün</span></div>)}<button className="coachAction" onClick={onProfile}>👤 Karakterimi Özelleştir</button></section></div>
    <section className="subjects">{subjects.map(s => <div className="subject" key={s[0]}><b>{s[0]}</b><strong>%{s[1]}</strong><span>{s[2]}</span><div className="bar"><i className={s[3]} style={{ width: `${s[1]}%` }} /></div></div>)}</section>
    <div className="lower"><section className="analytics"><h2>İlerleme Grafiği</h2><div className="fakeChart"><i/><i/><i/><i/><i/><span>1.Hafta　2.Hafta　3.Hafta　4.Hafta　5.Hafta</span></div></section><section className="errors"><h2>Hata Analiz Özeti</h2><div className="donut">52<small>Toplam Hata</small></div><ul><li>🔴 İşlem hatası　32%</li><li>🟠 Kavram yanılgısı　28%</li><li>🔵 Dikkat hatası　18%</li><li>🟣 Bilgi eksikliği　12%</li></ul></section></div>
    <section className="bottomCards"><div>🔥 <b>4 günlük çalışma serisi</b></div><div>🏆 <b>8 rozet kazandın</b></div><button onClick={onGame}>🎮 <b>2 oyun hakkı</b><small>Oyuna geç</small></button><div>🪑 <b>Çalışma odası · 3 öğe</b></div></section>
  </>;
}

function StudyHome({ onStart }: { onStart: () => void }) { return <section className="studyPage"><div className="studyIntro"><div><span className="eyebrow">BUGÜNÜN ÇALIŞMASI</span><h2>Matematik · Üslü İfadeler</h2><p>10 soru · Seviye 2 · Hata analizi dahil</p></div><button onClick={onStart} className="primary">Çalışmaya Başla →</button></div><div className="studyCards"><div><b>🎯 Hedef</b><strong>10 soru</strong><small>İlk 4 soru hazır</small></div><div><b>🧠 Odak</b><strong>H3</strong><small>Okuma ve modelleme</small></div><div><b>⭐ Kazanç</b><strong>+10 XP</strong><small>Hata analizinde +5 XP</small></div></div><div className="nextAction"><b>Şimdi ne yapmalıyım?</b><p>Önce soruyu çöz. Yanlış olursa sistem ilk hata noktasını birlikte belirleyecek; gerekirse konu tekrarı ve yeni soru önerecek.</p></div></section>; }

function QuestionModal({ avatar, onClose }: { avatar: string; onClose: () => void }) { const [selected,setSelected]=useState<number|null>(null); const [state,setState]=useState<AnswerState>('idle'); const [reason,setReason]=useState(''); const [showVoice,setShowVoice]=useState(false); const submit=()=>{ if(selected===null)return; setState(selected===question.correct?'correct':'wrong'); }; return <div className="modal"><div className="modalCard questionModal"><button className="close" onClick={onClose}>×</button><div className="qTop"><span>Matematik · Üslü İfadeler</span><b>4 / 10</b><span>⏱ 00:24</span></div><div className="qProgress"><i style={{width:'40%'}}/></div><div className="qBody"><img src={avatar} alt="Karakter"/><div><h2>{question.text}</h2><p className="skillTag">{question.skill} · Seviye {question.difficulty}</p></div></div><div className="options">{question.options.map((o,i)=><button key={o} className={selected===i?'selected':''} onClick={()=>{setSelected(i);setState('idle')}}><span>{String.fromCharCode(65+i)}</span>{o}</button>)}</div>{state==='idle'?<button className="primary full" onClick={submit}>Cevabımı Gönder</button>:state==='correct'?<div className="result success"><b>✓ Doğru cevap.</b><span>+10 XP kazandın. Bir sonraki soruya geçebilirsin.</span><button className="primary full" onClick={onClose}>Sonraki Soru</button></div>:<div className="result error"><b>Bu soruda hata yaptın.</b><span>Doğrudan “konu eksikliği” demiyoruz. İlk hata noktasını bulalım.</span><div className="reasonGrid">{['Soruyu anlamadım','Yöntemi bilmiyordum','İşlem hatası yaptım','Dikkatim dağıldı'].map(x=><button className={reason===x?'selected':''} onClick={()=>setReason(x)} key={x}>{x}</button>)}</div><button className="secondary" onClick={()=>setShowVoice(true)}>🎙 Açıklamamı kaydet</button><button className="secondary">📷 Çözüm fotoğrafı yükle</button>{(reason||showVoice)&&<div className="analysisPreview"><b>AI ön analizi</b><p>{reason==='İşlem hatası yaptım'?'H4 · Hesaplama/işlem hatası olasılığı yüksek.':reason==='Soruyu anlamadım'?'H3 · Okuma, anlama veya modelleme noktası incelenmeli.':'Yanıt açıklaması analiz için hazır. Analiz tamamlandığında yalnızca türetilmiş öğrenme verisi tutulur.'}</p></div>}</div>}</div></div>; }

function CoachPage({ avatar }: { avatar: string }) { return <section className="coachPage"><div className="coachHeader"><img src={avatar} alt="Karakter"/><div><span className="eyebrow">AI KOÇ</span><h2>Bugünkü öğrenme durumun</h2><p>Son cevaplarına göre bir sonraki adımı birlikte seçelim.</p></div></div><div className="coachGrid"><div className="coachPanel"><h3>🔎 Hata analizi</h3><b>H3 · Okuma / modelleme</b><p>Son 10 Matematik sorusunda iki hatada verilen bilgileri ilişkilendirme aşamasında zorlanma görüldü.</p></div><div className="coachPanel"><h3>📚 Önerilen çalışma</h3><b>Üslü İfadeler → Problem içinde yorumlama</b><p>5 dakikalık konu özeti + 5 pekiştirme sorusu.</p><button className="primary">Çalışmayı Başlat</button></div><div className="coachPanel"><h3>🎙 Öğrenci açıklaması</h3><p>Ses ve fotoğraf yalnızca analiz amacıyla kullanılır. Analiz sonrası dosya kalıcı olarak silinir.</p><button className="secondary">Yeni açıklama ekle</button></div></div></section>; }

function ProgressPage() { return <section className="progressPage"><div className="pageTitle"><span className="eyebrow">ÖĞRENME ANALİZİ</span><h2>İlerleme</h2><p>Son 5 haftadaki performans ve hata türleri.</p></div><div className="progressStats"><div><small>Genel başarı</small><b>%74</b><span>+7 puan</span></div><div><small>Toplam soru</small><b>286</b><span>42 bu hafta</span></div><div><small>Hata analizi</small><b>52</b><span>38'i çözüldü</span></div><div><small>Çalışma serisi</small><b>4 gün</b><span>hedef: 7 gün</span></div></div><div className="analysisTable"><h3>Hata türleri</h3>{[['H1 · Kavram eksikliği',18],['H2 · Yöntem/strateji',22],['H3 · Okuma/modelleme',28],['H4 · İşlem hatası',32],['H5 · Gereksiz bilgi',12],['H6 · Bilgileri ilişkilendirme',24],['H7 · Dikkat/rastgelelik',15]].map(([x,n])=><div className="analysisRow" key={x as string}><span>{x}</span><i><b style={{width:`${Math.min(Number(n)*2.2,100)}%`}}/></i><em>{n}%</em></div>)}</div></section>; }

function RewardsPage({ onGame }: { onGame: () => void }) { return <section className="rewardsPage"><div className="pageTitle"><span className="eyebrow">ÖDÜLLER</span><h2>Çalıştıkça gelişen karakterin</h2><p>Ödüller doğru cevaptan çok düzenli çalışma, hata analizi ve gerçek gelişim davranışlarına bağlanır.</p></div><div className="rewardGrid"><div><span>⭐</span><b>245 XP</b><small>Bir sonraki seviye: 320 XP</small></div><div><span>🏆</span><b>8 Rozet</b><small>3 yeni rozet için ilerliyorsun</small></div><div><span>🎮</span><b>2 Oyun Hakkı</b><small>Günlük oyun süresi sınırı: 10 dk</small><button onClick={onGame}>Oyun Merkezini Aç</button></div><div><span>🪑</span><b>Çalışma Odası</b><small>3 eşya açık</small></div></div></section>; }

function Placeholder({ tab, onProfile, onGame }: { tab: Tab; onProfile: () => void; onGame: () => void }) { const copy: Record<Tab,[string,string]>={ 'Çalış':['Çalışma Alanı','Bugün için önerilen sorular ve konu tekrarları burada olacak.'],'AI Koç':['AI Koç','Hata analizleri ve kişisel çalışma önerileri.'],'Dersler':['Dersler','LGS dersleri ve konu haritası.'],'Sınavlar':['Sınavlar','Haftalık testler ve 5 haftalık denemeler.'],'Kaynaklar':['Kaynaklar','MEB kaynakları, güvenilir videolar ve kişiselleştirilmiş materyaller.'],'Ödüller':['Ödüller','XP, rozetler, oyun hakları ve karakter geliştirmeleri.'],'İlerleme':['İlerleme','Konu başarısı ve H1–H7 hata dağılımı.'],'Profil':['Profil & Karakter','Öğrenci bilgileri ve avatar ayarları.'],'Ana Sayfa':['','']}; return <section className="placeholder"><div className="placeholderIcon">📚</div><h2>{copy[tab][0]}</h2><p>{copy[tab][1]}</p><div className="placeholderActions"><button onClick={onProfile}>Karakterimi Özelleştir</button><button onClick={onGame}>Oyun Merkezi</button></div></section>; }

function ProfileModal({ draft,setDraft,avatarsForGender,avatar,onClose,onSave }:{draft:Profile;setDraft:(p:Profile)=>void;avatarsForGender:string[];avatar:string;onClose:()=>void;onSave:()=>void}) { return <div className="modal"><div className="modalCard profileModal"><button className="close" onClick={onClose}>×</button><div className="steps"><b>1 Hesap</b><span>2 Öğrenci</span><span>3 Karakter</span><span>4 Başla</span></div><h2>Karakterini Seç</h2><p>Sana en yakın karakteri seç. Daha sonra değiştirebilirsin.</p><label>Öğrenci adı<input value={draft.name} onChange={e=>setDraft({...draft,name:e.target.value})} placeholder="Örn. Elif"/></label><div className="genderTabs"><button className={draft.gender==='boy'?'selected':''} onClick={()=>setDraft({...draft,gender:'boy',avatar:0})}>👦 Erkek</button><button className={draft.gender==='girl'?'selected':''} onClick={()=>setDraft({...draft,gender:'girl',avatar:0})}>👧 Kız</button></div><div className="avatarChoices">{avatarsForGender.map((src,i)=><button className={draft.avatar===i?'avatarSelected':''} key={i} onClick={()=>setDraft({...draft,avatar:i})}><img src={src} alt="Avatar seçeneği"/></button>)}</div><div className="avatarPreview"><img src={avatar} alt="Seçilen avatar"/></div><button className="save" onClick={onSave}>Karakteri Kaydet</button></div></div>; }

function GameModal({onClose}:{onClose:()=>void}) { return <div className="modal"><div className="modalCard gameModal"><button className="close" onClick={onClose}>×</button><div className="gameHero">🎮</div><h2>Oyun Merkezi</h2><p>Bugün <b>2 oyun hakkın</b> var. Oyun süresi günlük sınır içinde tutulur.</p><div className="games"><button><b>🧠 Hafıza Kartları</b><small>5 dk · Başla</small></button><button><b>🔢 Mini 2048</b><small>5 dk · Başla</small></button></div><small className="privacyNote">Oyunlar çalışma hedeflerinden sonra açılır; amaç öğrenme davranışını desteklemektir.</small></div></div>; }
