{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lgs-ai-coach.local/schemas/canonical-question-v1.json",
  "title": "LGS canonical question staging record",
  "type": "object",
  "required": ["schema_version", "id", "source", "question", "answer_key", "curriculum", "extraction", "solution", "status", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 5},
    "source": {"type": "object", "required": ["source_id", "source_type", "official_index_url", "source_page_url", "discovered_from", "pdf_url", "final_url", "source_file_url", "redirect_chain", "source_sha256", "booklet", "question_number"], "properties": {"source_id": {"type": "string"}, "source_type": {"enum": ["REAL_LGS", "MEB_SAMPLE"]}, "year": {"type": "integer", "minimum": 2018}, "official_index_url": {"type": "string", "format": "uri", "pattern": "^https://([A-Za-z0-9-]+\\.)*meb\\.(gov\\.tr|k12\\.tr)(/|$)"}, "source_page_url": {"type": "string", "format": "uri", "pattern": "^https://([A-Za-z0-9-]+\\.)*meb\\.(gov\\.tr|k12\\.tr)(/|$)"}, "discovered_from": {"type": "string", "format": "uri", "pattern": "^https://([A-Za-z0-9-]+\\.)*meb\\.(gov\\.tr|k12\\.tr)(/|$)"}, "pdf_url": {"type": "string", "format": "uri", "pattern": "^https://((?:[A-Za-z0-9-]+\\.)*meb\\.(gov\\.tr|k12\\.tr)|cdn\\.eba\\.gov\\.tr)(/|$)"}, "final_url": {"type": "string", "format": "uri", "pattern": "^https://((?:[A-Za-z0-9-]+\\.)*meb\\.(gov\\.tr|k12\\.tr)|cdn\\.eba\\.gov\\.tr)(/|$)"}, "source_file_url": {"type": "string", "format": "uri", "pattern": "^https://((?:[A-Za-z0-9-]+\\.)*meb\\.(gov\\.tr|k12\\.tr)|cdn\\.eba\\.gov\\.tr)(/|$)"}, "redirect_chain": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "booklet": {"type": "string", "minLength": 1}, "question_number": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "question": {"type": "object", "required": ["grade", "subject", "stem", "options", "page_start", "page_end"], "properties": {"grade": {"const": 8}, "subject": {"type": ["string", "null"]}, "stem": {"type": "string"}, "options": {"type": "object", "propertyNames": {"pattern": "^[A-D]$"}, "additionalProperties": {"type": "string"}}, "page_start": {"type": "integer", "minimum": 1}, "page_end": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "answer_key": {"type": "object", "required": ["candidate", "answer", "authority", "source_verified", "answer_key_verified"], "properties": {"candidate": {"type": ["string", "null"], "pattern": "^[A-D]$"}, "answer": {"type": ["string", "null"], "pattern": "^[A-D]$"}, "authority": {"const": "OFFICIAL_MEB_ONLY"}, "source_verified": {"type": "boolean"}, "answer_key_verified": {"type": "boolean"}}, "additionalProperties": false},
    "curriculum": {"type": "object", "required": ["LGS_REFERENCE_2018_PLUS", "CURRENT_TYMM"], "properties": {"LGS_REFERENCE_2018_PLUS": {"$ref": "#/$defs/mapping"}, "CURRENT_TYMM": {"$ref": "#/$defs/mapping"}}, "additionalProperties": false},
    "extraction": {"type": "object", "required": ["method", "retrieved_at", "confidence", "warnings", "answer_key_candidates"], "properties": {"method": {"type": "string"}, "retrieved_at": {"type": "string", "format": "date-time"}, "confidence": {"enum": ["LOW", "UNREVIEWED", "HUMAN_REVIEWED"]}, "warnings": {"type": "array", "items": {"type": "string"}}, "answer_key_candidates": {"type": "array"}}},
    "solution": {"type": ["string", "null"]},
    "status": {"enum": ["DRAFT", "EXTRACTED", "AUTO_CHECKED", "NEEDS_REVIEW", "VERIFIED", "REJECTED"]},
    "checks": {"type": "object", "required": ["source_verified", "year_verified", "booklet_verified", "question_number_verified", "text_verified", "options_verified", "answer_key_source_verified", "answer_key_verified", "curriculum_verified", "solution_verified", "duplicate_checked"], "additionalProperties": {"type": "boolean"}}
  },
  "$defs": {"mapping": {"type": "object", "required": ["status", "version", "subject", "unit", "topic", "learning_outcome", "skill", "evidence_url"], "properties": {"status": {"enum": ["UNMAPPED", "MAPPED_NEEDS_REVIEW", "VERIFIED"]}, "version": {"type": ["string", "null"]}, "subject": {"type": ["string", "null"]}, "unit": {"type": ["string", "null"]}, "topic": {"type": ["string", "null"]}, "learning_outcome": {"type": ["string", "null"]}, "skill": {"type": ["string", "null"]}, "evidence_url": {"type": ["string", "null"]}}, "additionalProperties": false}}
}
